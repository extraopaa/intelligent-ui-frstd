# Connexion France Student : l’écran de connexion ouvre le portail officiel.
# La connexion automatique (OAuth) nécessite un client autorisé par France Student.
# En attendant, l’accès se fait par clé API (personnelle ou serveur) ou en mode démo.

# Connexion serveur à l’Offre IA France Student (facultatif).
# Sans clé, l’application démarre en mode démo.

# FRANCESTUDENT_API_KEY=votre-cle-api
# FRANCESTUDENT_MODEL=gpt-6-luna
# FRANCESTUDENT_BASE_URL=https://api.francestudent.ai/v1

# Alias de compatibilité pour une passerelle OpenAI Responses locale (mock).
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=http://localhost:8787/v1

# Lien du dépôt affiché dans l’interface (open source).
# NEXT_PUBLIC_GITHUB_URL=https://github.com/votre-compte/intelligent-ui
